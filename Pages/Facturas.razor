@page "/facturas"
@using VeterinariaApp.Services
@using VeterinariaApp.Models
@inject AuthService AuthService
@inject FacturaService FacturaService
@inject NavigationManager Navigation

<PageTitle>Facturas - Sistema Veterinario</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="text-center py-5">
        <h3>Debes <a href="/login">iniciar sesión</a></h3>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>💰 Facturas</h2>
                <p class="text-muted">Gestión de facturas y pagos</p>
            </div>
            @if (CanCreateFactura())
            {
                <a href="/facturas/crear" class="btn btn-success btn-lg">
                    ➕ Nueva Factura
                </a>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
                <p class="mt-3">Cargando facturas...</p>
            </div>
        }
        else if (todasLasFacturas == null || !todasLasFacturas.Any())
        {
            <div class="alert alert-info">
                <h5>No hay facturas registradas</h5>
                @if (CantSeeMessage()){
                    <p class="mb-0">Solo los veterinarios pueden crear facturas.</p>
                }
                else
                {
                    <p class="mb-0">Crea tu primera factura haciendo clic en el botón "Nueva Factura".</p>
                }
            </div>
        }
        else
        {
            <!-- Filtros y Búsqueda -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Buscar por mascota, propietario o número:</label>
                            <input type="text" class="form-control" placeholder="Buscar..." @bind="searchTerm" @bind:event="oninput" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Filtrar por estado:</label>
                            <div class="btn-group w-100" role="group">
                                <button type="button" class="btn btn-sm @(filtroEstado == null ? "btn-dark" : "btn-outline-dark")" @onclick="@(() => filtroEstado = null)">
                                    Todos (@ContarPorEstado(null))
                                </button>
                                <button type="button" class="btn btn-sm @(filtroEstado == "pendiente" ? "btn-warning" : "btn-outline-warning")" @onclick="@(() => filtroEstado = "pendiente")">
                                    Pendientes (@ContarPorEstado("pendiente"))
                                </button>
                                <button type="button" class="btn btn-sm @(filtroEstado == "pagada" ? "btn-success" : "btn-outline-success")" @onclick="@(() => filtroEstado = "pagada")">
                                    Pagadas (@ContarPorEstado("pagada"))
                                </button>
                                <button type="button" class="btn btn-sm @(filtroEstado == "anulada" ? "btn-danger" : "btn-outline-danger")" @onclick="@(() => filtroEstado = "anulada")">
                                    Anuladas (@ContarPorEstado("anulada"))
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!FacturasFiltradas().Any())
            {
                <div class="alert alert-warning">
                    <h5>No se encontraron facturas</h5>
                    <p class="mb-0">Intenta con otros criterios de búsqueda o filtros.</p>
                </div>
            }
            else
            {
                @foreach (var grupo in FacturasAgrupadasYOrdenadas())
                {
                    <!-- Header del grupo -->
                    <div class="card mb-3 shadow-sm border-@GetEstadoBadgeColor(grupo.Key)">
                        <div class="card-header bg-@GetEstadoBadgeColor(grupo.Key) text-white">
                            <h5 class="mb-0">
                                @grupo.Key.ToUpper() 
                                <span class="badge bg-light text-dark ms-2">@grupo.Count()</span>
                            </h5>
                        </div>
                    </div>

                    <!-- Facturas del grupo -->
                    <div class="row">
                        @foreach (var factura in grupo)
                        {
                            var isAnulada = factura.IsDeleted || factura.Estado == "anulada";
                            var isPagada = factura.Estado == "pagada";
                            
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 @(isAnulada ? "opacity-50" : "")" style="border-left: 4px solid @GetEstadoBorderColor(factura.Estado)">
                                    <div class="card-body position-relative">
                                        @if (isAnulada)
                                        {
                                            <span class="badge bg-danger position-absolute top-0 end-0 m-2">Anulada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-@GetEstadoBadgeColor(factura.Estado) position-absolute top-0 end-0 m-2">
                                                @factura.Estado.ToUpper()
                                            </span>
                                        }
                                        <br />
                                        <h5 class="card-title @(isAnulada ? "text-muted text-decoration-line-through" : "")">
                                                @factura.NumeroFactura
                                        </h5>
                                        <p class="card-text">
                                            <strong>Mascota:</strong> @factura.MascotaNombre<br />
                                            <strong>Propietario:</strong> @factura.PropietarioNombre<br />
                                            <strong>Fecha:</strong> @factura.FechaFactura.ToString("dd/MM/yyyy")<br />
                                            <strong>Servicio:</strong> @GetTipoServicioDisplay(factura.TipoServicio)<br />
                                            <strong>Veterinario:</strong> @factura.VeterinarioNombre<br />
                                            <hr />
                                            <strong class="text-success fs-5">Total: $@factura.Total.ToString("N2")</strong>
                                        </p>
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="d-grid gap-2">
                                            <button class="btn btn-outline-info btn-sm" @onclick="() => ViewFactura(factura.IdFactura)">
                                                Ver Detalles
                                            </button>
                                            @if (!isAnulada && CanEditFactura(factura))
                                            {
                                                <button class="btn btn-outline-warning btn-sm" @onclick="() => EditFactura(factura.IdFactura)">
                                                    Editar
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
    </div>
}

@code {
    private List<Factura> todasLasFacturas = new();
    private string? errorMessage;
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string? filtroEstado = null;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            await LoadFacturas();
        }
    }

    private async Task LoadFacturas()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var paginatedResponse = await FacturaService.GetFacturasAsync(
                page: 1,
                pageSize: 500,
                includeDeleted: true  // Mostrar facturas anuladas con indicador visual
            );

            todasLasFacturas = paginatedResponse?.Items ?? new List<Factura>();
        }
        catch (UnauthorizedAccessException ex)
        {
            Console.WriteLine($"Sesión expirada: {ex.Message}");
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login", true);
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar facturas: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<Factura> FacturasFiltradas()
    {
        var facturas = todasLasFacturas.AsEnumerable();

        // Filtrar por búsqueda
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var searchLower = searchTerm.ToLower();
            facturas = facturas.Where(f =>
                (f.MascotaNombre?.ToLower().Contains(searchLower) ?? false) ||
                (f.PropietarioNombre?.ToLower().Contains(searchLower) ?? false) ||
                (f.NumeroFactura?.ToLower().Contains(searchLower) ?? false) ||
                (f.VeterinarioNombre?.ToLower().Contains(searchLower) ?? false)
            );
        }

        // Filtrar por estado
        if (!string.IsNullOrWhiteSpace(filtroEstado))
        {
            facturas = facturas.Where(f => f.Estado == filtroEstado);
        }

        return facturas.ToList();
    }

    private IEnumerable<IGrouping<string, Factura>> FacturasAgrupadasYOrdenadas()
    {
        var facturas = FacturasFiltradas();

        // Ordenar por prioridad de estado y fecha
        var ordenadas = facturas.OrderBy(f => GetPrioridadEstado(f.Estado))
                                .ThenByDescending(f => f.FechaFactura);

        // Agrupar por estado
        return ordenadas.GroupBy(f => f.Estado);
    }

    private int GetPrioridadEstado(string estado)
    {
        return estado switch
        {
            "pendiente" => 1,  // Primera prioridad
            "pagada" => 2,     // Segunda prioridad
            "anulada" => 3,    // Tercera prioridad
            _ => 4             // Último
        };
    }

    private int ContarPorEstado(string? estado)
    {
        if (estado == null)
            return todasLasFacturas.Count;
        
        return todasLasFacturas.Count(f => f.Estado == estado);
    }

    private void ViewFactura(string id)
    {
        Navigation.NavigateTo($"/facturas/{id}");
    }

    private void EditFactura(string id)
    {
        Navigation.NavigateTo($"/facturas/{id}/editar");
    }

    private bool CanCreateFactura()
    {
        var role = AuthService.CurrentUser?.Role;
        return role == "admin" || role == "veterinario";
    }

    private bool CantSeeMessage(){
        var role = AuthService.CurrentUser?.Role;
        return role == "cliente";
    }

    private bool CanEditFactura(Factura factura)
    {
        if (factura.Estado != "pendiente") return false;
        
        var role = AuthService.CurrentUser?.Role;
        var username = AuthService.CurrentUser?.Username;
        
        // Admin puede editar cualquier factura pendiente
        if (role == "admin")
            return true;
        
        // Veterinario solo puede editar sus propias facturas pendientes
        if (role == "veterinario" && factura.Veterinario == username)
            return true;
        
        return false;
    }

    private string GetEstadoBadgeColor(string estado)
    {
        return estado switch
        {
            "pendiente" => "warning",
            "pagada" => "success",
            "anulada" => "danger",
            _ => "secondary"
        };
    }

    private string GetEstadoBorderColor(string estado)
    {
        return estado switch
        {
            "pendiente" => "#ffc107",
            "pagada" => "#28a745",
            "anulada" => "#dc3545",
            _ => "#6c757d"
        };
    }

    private string GetEstadoIcon(string estado)
    {
        return estado switch
        {
            "pendiente" => "⏳",
            "pagada" => "✅",
            "anulada" => "❌",
            _ => "📄"
        };
    }

    private string GetTipoServicioDisplay(string tipo)
    {
        return tipo switch
        {
            "consulta_general" => "Consulta General",
            "vacunacion" => "Vacunación",
            "cirugia" => "Cirugía",
            "emergencia" => "Emergencia",
            "control" => "Control",
            "desparasitacion" => "Desparasitación",
            _ => tipo
        };
    }
}
