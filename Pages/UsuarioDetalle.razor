@page "/usuarios/{UsuarioId}"
@using VeterinariaApp.Services
@using VeterinariaApp.Models
@inject AuthService AuthService
@inject UsuarioService UsuarioService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Detalles de Usuario - Sistema Veterinario</PageTitle>

@if (!AuthService.IsAuthenticated || !IsAdmin())
{
    <div class="container">
        <div class="alert alert-warning mt-5">
            <h4>Acceso No Autorizado</h4>
            <p>Solo los administradores pueden acceder a esta página.</p>
        </div>
        <div class="text-center">
            <button class="btn btn-primary mt-3" @onclick="GoHome">← Volver al Inicio</button>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <button class="btn btn-outline-secondary mb-2" @onclick="GoBack">
                    ← Volver a Usuarios
                </button>
                <h2>👤 Detalles de Usuario</h2>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
                <p class="mt-3">Cargando información del usuario...</p>
            </div>
        }
        else if (usuario == null)
        {
            <div class="alert alert-danger">
                <h5>Usuario no encontrado</h5>
                <p class="mb-0">El usuario solicitado no existe o no tienes permisos para verlo.</p>
            </div>
        }
        else
        {
            <div class="row">
                <!-- Información del Usuario -->
                <div class="col-lg-8">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Información Personal</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted">ID de Usuario</label>
                                    <p class="form-control-plaintext fw-bold">@usuario.IdUsuario</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">Nombre de Usuario</label>
                                    <p class="form-control-plaintext fw-bold">
                                        @usuario.Username
                                        @if (usuario.Username == AuthService.CurrentUser?.Username)
                                        {
                                            <span class="badge bg-info ms-2">Eres tú</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted">Nombre Completo</label>
                                    <p class="form-control-plaintext fw-bold">@usuario.Nombre</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">Edad</label>
                                    <p class="form-control-plaintext fw-bold">@usuario.Edad años</p>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted">Teléfono</label>
                                    <p class="form-control-plaintext fw-bold">@usuario.Telefono</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted">Fecha de Creación</label>
                                    <p class="form-control-plaintext fw-bold">@usuario.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label text-muted">Estado</label>
                                    <p class="form-control-plaintext">
                                        @if (usuario.IsDeleted)
                                        {
                                            <span class="badge bg-danger">Eliminado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel de Administración -->
                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">Configuración de Rol</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Rol Actual:</label>
                                <div class="mb-3">
                                    <span class="badge @GetRoleBadgeClass(usuario.Role) fs-5">
                                        @GetRoleDisplay(usuario.Role)
                                    </span>
                                </div>
                            </div>

                            @if (!isCurrentUser)
                            {
                                <hr />
                                <label class="form-label">Cambiar Rol a:</label>
                                <select class="form-select mb-3" @bind="selectedRole">
                                    <option value="cliente">Cliente</option>
                                    <option value="veterinario">Veterinario</option>
                                    <option value="admin">Administrador</option>
                                </select>

                                <button class="btn btn-primary w-100 mb-2" @onclick="ChangeRole" disabled="@isChangingRole">
                                    @if (isChangingRole)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Cambiando...</span>
                                    }
                                    else
                                    {
                                        <span>Cambiar Rol</span>
                                    }
                                </button>
                            }
                            else
                            {
                                <div class="alert alert-info small mb-0">
                                    No puedes cambiar tu propio rol. Solicita a otro administrador que lo haga.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Acciones Peligrosas -->
                    @if (!isCurrentUser)
                    {
                        <div class="card shadow-sm border-danger">
                            <div class="card-header bg-danger text-white">
                                <h5 class="mb-0">Desactivar cuenta</h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted small mb-3">
                                    Las siguientes acciones modifican el estado de la cuenta del usuario.
                                </p>
                                
                                @if (!usuario.IsDeleted)
                                {
                                    <button class="btn btn-outline-danger w-100" @onclick="DeleteUser" disabled="@isDeletingUser">
                                        @if (isDeletingUser)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            <span>Eliminando...</span>
                                        }
                                        else
                                        {
                                            <span>Desactivar Usuario</span>
                                        }
                                    </button>
                                    <p class="text-muted small mb-0 mt-2">
                                        Esta acción desactiva la cuenta del usuario (soft-delete).
                                    </p>
                                }
                                else
                                {
                                    <button class="btn btn-outline-success w-100" @onclick="RestoreUser" disabled="@isRestoringUser">
                                        @if (isRestoringUser)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            <span>Restaurando...</span>
                                        }
                                        else
                                        {
                                            <span>Restaurar Usuario</span>
                                        }
                                    </button>
                                    <p class="text-muted small mb-0 mt-2">
                                        Esta acción reactiva la cuenta del usuario.
                                    </p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public string UsuarioId { get; set; } = string.Empty;

    private Usuario? usuario;
    private string selectedRole = "cliente";
    private bool isLoading = true;
    private bool isChangingRole = false;
    private bool isDeletingUser = false;
    private bool isRestoringUser = false;
    private bool isCurrentUser = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!IsAdmin())
        {
            return;
        }

        await LoadUsuario();
    }

    private async Task LoadUsuario()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            usuario = await UsuarioService.GetUsuarioAsync(UsuarioId);
            
            if (usuario != null)
            {
                selectedRole = usuario.Role;
                isCurrentUser = usuario.IdUsuario == AuthService.CurrentUser?.IdUsuario;
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            Console.WriteLine($"Sesión expirada: {ex.Message}");
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login", true);
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar el usuario: " + ex.Message;
            Console.WriteLine($"Error: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeRole()
    {
        if (usuario == null || isCurrentUser)
            return;

        if (selectedRole == usuario.Role)
        {
            errorMessage = "El rol seleccionado es el mismo que el actual.";
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Estás seguro de cambiar el rol de {usuario.Username} a {GetRoleDisplay(selectedRole)}?");
        
        if (!confirmed)
            return;

        isChangingRole = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var updatedUsuario = await UsuarioService.ChangeUserRoleAsync(usuario.IdUsuario, selectedRole);
            
            if (updatedUsuario != null)
            {
                successMessage = $"Rol actualizado exitosamente a {GetRoleDisplay(selectedRole)}";
                usuario = updatedUsuario;
                selectedRole = updatedUsuario.Role;
            }
            else
            {
                errorMessage = "Error al cambiar el rol. Intenta nuevamente.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cambiar el rol: " + ex.Message;
            Console.WriteLine($"Error changing role: {ex}");
        }
        finally
        {
            isChangingRole = false;
        }
    }

    private bool IsAdmin()
    {
        return AuthService.CurrentUser?.Role == "admin";
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/usuarios");
    }

    private string GetRoleDisplay(string role)
    {
        return role switch
        {
            "admin" => "👑 Administrador",
            "veterinario" => "Veterinario",
            "cliente" => "Cliente",
            _ => role
        };
    }

    private string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "admin" => "bg-danger",
            "veterinario" => "bg-success",
            "cliente" => "bg-primary",
            _ => "bg-secondary"
        };
    }

    private async Task DeleteUser()
    {
        if (usuario == null || isCurrentUser)
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Estás seguro de eliminar la cuenta de {usuario.Username}?\n\nEsta acción desactivará su cuenta (soft-delete) pero podrá ser restaurada posteriormente.");
        
        if (!confirmed)
            return;

        isDeletingUser = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var success = await UsuarioService.DeleteUsuarioAsync(usuario.IdUsuario);
            
            if (success)
            {
                successMessage = $"Usuario {usuario.Username} eliminado exitosamente. La cuenta ha sido desactivada.";
                // Reload user to update the IsDeleted status
                await LoadUsuario();
            }
            else
            {
                errorMessage = "Error al eliminar el usuario. Intenta nuevamente.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al eliminar el usuario: " + ex.Message;
            Console.WriteLine($"Error deleting user: {ex}");
        }
        finally
        {
            isDeletingUser = false;
        }
    }

    private async Task RestoreUser()
    {
        if (usuario == null || isCurrentUser)
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
            $"¿Estás seguro de restaurar la cuenta de {usuario.Username}?\n\nEsta acción reactivará su cuenta permitiéndole volver a acceder al sistema.");
        
        if (!confirmed)
            return;

        isRestoringUser = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var success = await UsuarioService.RestoreUsuarioAsync(usuario.IdUsuario);
            
            if (success)
            {
                successMessage = $"Usuario {usuario.Username} restaurado exitosamente. La cuenta ha sido reactivada.";
                // Reload user to update the IsDeleted status
                await LoadUsuario();
            }
            else
            {
                errorMessage = "Error al restaurar el usuario. Intenta nuevamente.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al restaurar el usuario: " + ex.Message;
            Console.WriteLine($"Error restoring user: {ex}");
        }
        finally
        {
            isRestoringUser = false;
        }
    }
}
