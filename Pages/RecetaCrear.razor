@page "/recetas/crear"
@using VeterinariaApp.Services
@using VeterinariaApp.Models
@inject AuthService AuthService
@inject RecetaService RecetaService
@inject CitaService CitaService
@inject NavigationManager Navigation

<PageTitle>Nueva Receta - Sistema Veterinario</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="text-center py-5">
        <h3>Debes <a href="/login">iniciar sesión</a></h3>
    </div>
}
else if (!CanCreateReceta())
{
    <div class="container">
        <div class="alert alert-warning mt-5">
            <h4>⚠️ Acceso No Autorizado</h4>
            <p>Solo los veterinarios y administradores pueden crear recetas médicas.</p>
        </div>
        <div class="text-center">
            <button class="btn btn-primary mt-3" @onclick="GoBack">← Volver a Recetas</button>
        </div>
    </div>
}
else
{
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">📋 Nueva Receta Médica</h4>
                    </div>
                    <div class="card-body">
                        @if (isLoadingCitas)
                        {
                            <div class="text-center py-3">
                                <div class="spinner-border text-primary"></div>
                                <p>Cargando citas...</p>
                            </div>
                        }
                        else if (citas == null || !citas.Any())
                        {
                            <div class="alert alert-warning">
                                <strong>⚠️ No hay citas disponibles</strong>
                                <p class="mb-0">Solo puedes crear recetas para citas completadas que aún no tengan receta asociada.</p>
                            </div>
                            <div class="text-center mt-3">
                                <button class="btn btn-secondary" @onclick="GoBack">← Volver</button>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger" role="alert">
                                    @errorMessage
                                </div>
                            }

                            <EditForm Model="@receta" OnValidSubmit="HandleSubmit">
                                <div class="mb-3">
                                    <label class="form-label">Cita *</label>
                                    <InputSelect @bind-Value="receta.IdCita" class="form-select" @onchange="OnCitaChanged">
                                        <option value="">Selecciona una cita...</option>
                                        @foreach (var cita in citas)
                                        {
                                            <option value="@cita.IdCita">
                                                @cita.Fecha.ToString("dd/MM/yyyy HH:mm") - 🐾 @cita.NombreMascota - @cita.Motivo
                                            </option>
                                        }
                                    </InputSelect>
                                    <small class="text-muted">Selecciona la cita para la cual se emitirá la receta</small>
                                </div>

                                @if (citaSeleccionada != null)
                                {
                                    <div class="alert alert-info mb-3">
                                        <strong>📋 Información de la Cita:</strong><br />
                                        🐾 <strong>Mascota:</strong> @citaSeleccionada.NombreMascota<br />
                                        👤 <strong>Propietario:</strong> @citaSeleccionada.PropietarioNombre<br />
                                        📅 <strong>Fecha:</strong> @citaSeleccionada.Fecha.ToString("dd/MM/yyyy HH:mm")<br />
                                        📝 <strong>Motivo:</strong> @citaSeleccionada.Motivo
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label">Indicaciones Generales</label>
                                    <InputTextArea @bind-Value="receta.Indicaciones" class="form-control" rows="3" 
                                                   placeholder="Indicaciones generales para el tratamiento..." />
                                    <small class="text-muted">Instrucciones generales sobre el tratamiento</small>
                                </div>

                                <!-- Líneas de Medicamentos -->
                                <div class="card border-warning mb-3">
                                    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">💊 Medicamentos Prescritos</h5>
                                        <button type="button" class="btn btn-sm btn-success" @onclick="AgregarLinea">
                                            ➕ Agregar Medicamento
                                        </button>
                                    </div>
                                    <div class="card-body">
                                        @if (lineas == null || !lineas.Any())
                                        {
                                            <div class="alert alert-info mb-0">
                                                <p class="mb-0">No hay medicamentos agregados. Haz clic en "Agregar Medicamento" para comenzar.</p>
                                            </div>
                                        }
                                        else
                                        {
                                            @for (int i = 0; i < lineas.Count; i++)
                                            {
                                                var index = i;
                                                var linea = lineas[index];
                                                
                                                <div class="card mb-3 @(index % 2 == 0 ? "bg-light" : "")">
                                                    <div class="card-body">
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <h6 class="mb-0">💊 Medicamento #@(index + 1)</h6>
                                                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => EliminarLinea(index)">
                                                                🗑️ Eliminar
                                                            </button>
                                                        </div>
                                                        
                                                        <div class="row">
                                                            <div class="col-md-6 mb-2">
                                                                <label class="form-label">Medicamento *</label>
                                                                <input type="text" class="form-control" 
                                                                       @bind="linea.Medicamento" 
                                                                       placeholder="Nombre del medicamento" />
                                                            </div>
                                                            <div class="col-md-6 mb-2">
                                                                <label class="form-label">Dosis</label>
                                                                <input type="text" class="form-control" 
                                                                       @bind="linea.Dosis" 
                                                                       placeholder="Ej: 500mg, 1 comprimido" />
                                                            </div>
                                                            <div class="col-md-6 mb-2">
                                                                <label class="form-label">Frecuencia</label>
                                                                <input type="text" class="form-control" 
                                                                       @bind="linea.Frecuencia" 
                                                                       placeholder="Ej: Cada 8 horas, 2 veces al día" />
                                                            </div>
                                                            <div class="col-md-6 mb-2">
                                                                <label class="form-label">Duración</label>
                                                                <input type="text" class="form-control" 
                                                                       @bind="linea.Duracion" 
                                                                       placeholder="Ej: 7 días, 2 semanas" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary btn-lg" disabled="@isLoading">
                                        @if (isLoading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        💾 Crear Receta
                                    </button>
                                    <button type="button" class="btn btn-secondary" @onclick="Cancel">
                                        Cancelar
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private RecetaCreate receta = new();
    private List<RecetaLinea> lineas = new();
    private List<Cita> citas = new();
    private Cita? citaSeleccionada = null;
    private string? errorMessage;
    private bool isLoading;
    private bool isLoadingCitas = true;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!CanCreateReceta())
        {
            return;
        }

        await LoadCitas();
    }

    private async Task LoadCitas()
    {
        isLoadingCitas = true;
        try
        {
            // Cargar citas completadas
            var citasResponse = await CitaService.GetCitasAsync(
                page: 1,
                pageSize: 100,
                estado: "completada",
                includeDeleted: false
            );
            
            var todasCitas = citasResponse?.Items ?? new List<Cita>();
            
            // Cargar todas las recetas para saber qué citas ya tienen receta
            var recetasResponse = await RecetaService.GetRecetasAsync(
                page: 1,
                pageSize: 500,
                includeDeleted: false
            );
            
            var recetas = recetasResponse?.Items ?? new List<Receta>();
            var citasConReceta = new HashSet<string>(
                recetas.Where(r => !string.IsNullOrEmpty(r.IdCita))
                       .Select(r => r.IdCita)
            );
            
            // Filtrar solo citas que NO tienen receta
            citas = todasCitas.Where(c => !citasConReceta.Contains(c.IdCita)).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar citas: {ex.Message}";
        }
        finally
        {
            isLoadingCitas = false;
        }
    }

    private void OnCitaChanged(ChangeEventArgs e)
    {
        var citaId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(citaId))
        {
            citaSeleccionada = citas.FirstOrDefault(c => c.IdCita == citaId);
        }
        else
        {
            citaSeleccionada = null;
        }
    }

    private void AgregarLinea()
    {
        lineas.Add(new RecetaLinea());
    }

    private void EliminarLinea(int index)
    {
        if (index >= 0 && index < lineas.Count)
        {
            lineas.RemoveAt(index);
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            if (string.IsNullOrWhiteSpace(receta.IdCita))
            {
                errorMessage = "Debes seleccionar una cita";
                return;
            }

            // Validar que haya al menos un medicamento
            if (lineas == null || !lineas.Any())
            {
                errorMessage = "Debes agregar al menos un medicamento";
                return;
            }

            // Validar que todos los medicamentos tengan nombre
            foreach (var linea in lineas)
            {
                if (string.IsNullOrWhiteSpace(linea.Medicamento))
                {
                    errorMessage = "Todos los medicamentos deben tener un nombre";
                    return;
                }
            }

            // Asignar líneas a la receta
            receta.Lineas = lineas;

            var result = await RecetaService.CreateRecetaAsync(receta);

            if (result != null)
            {
                Navigation.NavigateTo($"/recetas/{result.IdReceta}");
            }
            else
            {
                errorMessage = "Error al crear la receta";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool CanCreateReceta()
    {
        var role = AuthService.CurrentUser?.Role;
        return role == "admin" || role == "veterinario";
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/recetas");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/recetas");
    }
}
