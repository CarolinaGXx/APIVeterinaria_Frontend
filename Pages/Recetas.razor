@page "/recetas"
@using VeterinariaApp.Services
@using VeterinariaApp.Models
@inject AuthService AuthService
@inject RecetaService RecetaService
@inject NavigationManager Navigation

<PageTitle>Recetas - Sistema Veterinario</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="text-center py-5">
        <h3>Debes <a href="/login">iniciar sesión</a></h3>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>📋 Recetas Médicas</h2>
                <p class="text-muted">Prescripciones y medicamentos</p>
            </div>
            @if (CanCreateReceta())
            {
                <a href="/recetas/crear" class="btn btn-primary btn-lg">
                    ➕ Nueva Receta
                </a>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
                <p class="mt-3">Cargando recetas...</p>
            </div>
        }
        else if (recetas == null || !recetas.Any())
        {
            <div class="alert alert-info">
                <h5>No hay recetas registradas</h5>
                @if (!CanCreateReceta())
                {
                    <p class="mb-0">Solo los veterinarios pueden crear recetas médicas.</p>
                }
                else
                {
                    <p class="mb-0">Crea tu primera receta haciendo clic en el botón "Nueva Receta".</p>
                }
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var receta in recetas)
                {
                    var isEliminada = receta.IsDeleted;
                    
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 @(isEliminada ? "opacity-50" : "")" style="border-left: 4px solid #17a2b8">
                            <div class="card-body position-relative">
                                @if (isEliminada)
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">Eliminada</span>
                                }
                                
                                <h5 class="card-title @(isEliminada ? "text-muted text-decoration-line-through" : "")">
                                    Receta #@receta.IdReceta.Substring(0, 8)
                                </h5>
                                <p class="card-text">
                                    <strong>Mascota:</strong> @receta.MascotaNombre<br />
                                    <strong>Propietario:</strong> @receta.PropietarioNombre<br />
                                    <strong>Emisión:</strong> @receta.FechaEmision.ToString("dd/MM/yyyy")<br />
                                    <strong>Veterinario:</strong> @receta.VeterinarioNombre<br />
                                </p>
                            </div>
                            <div class="card-footer bg-transparent">
                                <div class="d-grid gap-2">
                                    <button class="btn btn-outline-info btn-sm" @onclick="() => ViewReceta(receta.IdReceta)">
                                        Ver Detalles
                                    </button>
                                    @if (!isEliminada && CanEditReceta(receta))
                                    {
                                        <button class="btn btn-outline-warning btn-sm" @onclick="() => EditReceta(receta.IdReceta)">
                                            Editar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (paginatedResponse != null && paginatedResponse.TotalPages > 1)
            {
                <nav aria-label="Paginación">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => LoadRecetas(currentPage - 1)">Anterior</button>
                        </li>
                        @for (int i = 1; i <= paginatedResponse.TotalPages; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                <button class="page-link" @onclick="() => LoadRecetas(pageNum)">@pageNum</button>
                            </li>
                        }
                        <li class="page-item @(currentPage == paginatedResponse.TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => LoadRecetas(currentPage + 1)">Siguiente</button>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
}

@code {
    private List<Receta> recetas = new();
    private PaginatedResponse<Receta>? paginatedResponse;
    private int currentPage = 1;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            await LoadRecetas();
        }
    }

    private async Task LoadRecetas(int page = 1)
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            currentPage = page;
            paginatedResponse = await RecetaService.GetRecetasAsync(
                page: currentPage,
                pageSize: 9,
                includeDeleted: true  // Mostrar recetas eliminadas con indicador visual
            );

            recetas = paginatedResponse?.Items ?? new List<Receta>();
        }
        catch (UnauthorizedAccessException ex)
        {
            Console.WriteLine($"Sesión expirada: {ex.Message}");
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/login", true);
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar recetas: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewReceta(string id)
    {
        Navigation.NavigateTo($"/recetas/{id}");
    }

    private void EditReceta(string id)
    {
        Navigation.NavigateTo($"/recetas/{id}/editar");
    }

    private bool CanCreateReceta()
    {
        var role = AuthService.CurrentUser?.Role;
        return role == "admin" || role == "veterinario";
    }

    private bool CanEditReceta(Receta receta)
    {
        var role = AuthService.CurrentUser?.Role;
        var username = AuthService.CurrentUser?.Username;
        
        // Admin puede editar cualquier receta
        if (role == "admin")
            return true;
        
        // Veterinario solo puede editar sus propias recetas
        if (role == "veterinario" && receta.Veterinario == username)
            return true;
        
        return false;
    }
}
