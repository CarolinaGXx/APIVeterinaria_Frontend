@page "/perfil"
@using VeterinariaApp.Services
@using VeterinariaApp.Models
@inject AuthService AuthService
@inject UsuarioService UsuarioService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Mi Perfil - Sistema Veterinario</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="text-center py-5">
        <h3>Debes <a href="/login">iniciar sesión</a></h3>
    </div>
}
else if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
        <p class="mt-3">Cargando perfil...</p>
    </div>
}
else if (usuario == null)
{
    <div class="alert alert-danger">
        Error al cargar el perfil
    </div>
}
else
{
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                    </div>
                }

                <div class="card">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">👤 Mi Perfil</h4>
                        <span class="badge @GetRoleBadgeClass()">@GetRoleDisplay(usuario.Role)</span>
                    </div>
                    <div class="card-body">
                        @if (!isEditing)
                        {
                            <!-- Modo Vista -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Usuario:</label>
                                    <p class="form-control-plaintext">@usuario.Username</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Nombre Completo:</label>
                                    <p class="form-control-plaintext">@usuario.Nombre</p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Edad:</label>
                                    <p class="form-control-plaintext">@usuario.Edad años</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Teléfono:</label>
                                    <p class="form-control-plaintext">@usuario.Telefono</p>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Rol:</label>
                                    <p class="form-control-plaintext">@GetRoleDisplay(usuario.Role)</p>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Fecha de Creación:</label>
                                    <p class="form-control-plaintext">@usuario.FechaCreacion.ToString("dd/MM/yyyy")</p>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button class="btn btn-warning btn-lg" @onclick="EnableEditing">
                                    Editar perfil
                                </button>
                            </div>
                        }
                        else
                        {
                            <!-- Modo Edición -->
                            <EditForm Model="@usuarioUpdate" OnValidSubmit="HandleUpdate">
                                <div class="mb-3">
                                    <label class="form-label">Usuario *</label>
                                    <InputText @bind-Value="usuarioUpdate.Username" class="form-control" placeholder="Nombre de usuario" />
                                    <small style="color: #000000;">Al cambiar tu usuario, todas tus mascotas y registros se actualizarán automáticamente</small>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Nombre Completo *</label>
                                    <InputText @bind-Value="usuarioUpdate.Nombre" class="form-control" placeholder="Tu nombre completo" />
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Edad *</label>
                                        <InputNumber @bind-Value="usuarioUpdate.Edad" class="form-control" min="0" max="150" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Teléfono *</label>
                                        <InputText @bind-Value="usuarioUpdate.Telefono" class="form-control" placeholder="555-1234" />
                                    </div>
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-success btn-lg" disabled="@isSaving">
                                        @if (isSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        Guardar Cambios
                                    </button>
                                    <button type="button" class="btn btn-secondary" @onclick="CancelEditing">
                                        Cancelar
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </div>

                <div class="card mt-4 border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Desactivar Cuenta</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">
                            Esta acción desactivará tu cuenta. Los administradores podrán restaurarla si es necesario.
                        </p>
                        <button class="btn btn-danger" @onclick="DeleteAccount">
                            Desactivar mi cuenta
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Usuario? usuario;
    private UsuarioUpdate usuarioUpdate = new();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isSaving = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPerfil();
    }

    private async Task LoadPerfil()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            usuario = await UsuarioService.GetMiPerfilAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar el perfil: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EnableEditing()
    {
        if (usuario == null) return;

        isEditing = true;
        usuarioUpdate = new UsuarioUpdate
        {
            Username = usuario.Username,
            Nombre = usuario.Nombre,
            Edad = usuario.Edad,
            Telefono = usuario.Telefono
        };
    }

    private void CancelEditing()
    {
        isEditing = false;
        usuarioUpdate = new();
        errorMessage = null;
    }

    private async Task HandleUpdate()
    {
        errorMessage = null;
        successMessage = null;
        isSaving = true;

        try
        {
            var result = await UsuarioService.UpdateMiPerfilAsync(usuarioUpdate);

            if (result != null)
            {
                // Actualizar el usuario local
                await LoadPerfil();
                
                // Actualizar también en AuthService si cambió el username
                if (usuario != null && AuthService.CurrentUser != null)
                {
                    AuthService.CurrentUser.Username = usuario.Username;
                    AuthService.CurrentUser.Nombre = usuario.Nombre;
                }

                successMessage = "Perfil actualizado exitosamente";
                isEditing = false;
            }
            else
            {
                errorMessage = "Error al actualizar el perfil";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAccount()
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "¿Estás seguro de que deseas eliminar tu cuenta? Esta acción desactivará tu cuenta."))
        {
            return;
        }

        try
        {
            if (await UsuarioService.DeleteMiCuentaAsync())
            {
                await JSRuntime.InvokeVoidAsync("alert", "Cuenta eliminada. Serás redirigido al inicio de sesión.");
                await AuthService.LogoutAsync();
                Navigation.NavigateTo("/login", true);
            }
            else
            {
                errorMessage = "Error al eliminar la cuenta";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private string GetRoleDisplay(string role)
    {
        return role switch
        {
            "admin" => "👑 Administrador",
            "veterinario" => "Veterinario",
            "cliente" => "Cliente",
            _ => role
        };
    }

    private string GetRoleBadgeClass()
    {
        if (usuario == null) return "bg-secondary";
        
        return usuario.Role switch
        {
            "admin" => "bg-danger",
            "veterinario" => "bg-success",
            "cliente" => "bg-primary",
            _ => "bg-secondary"
        };
    }
}
