@page "/mascotas/{id}"
@using VeterinariaApp.Services
@using VeterinariaApp.Models
@inject AuthService AuthService
@inject MascotaService MascotaService
@inject CitaService CitaService
@inject VacunaService VacunaService
@inject FacturaService FacturaService
@inject RecetaService RecetaService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Detalle de Mascota - Sistema Veterinario</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="text-center py-5">
        <h3>Debes <a href="/login">iniciar sesión</a> para ver esta mascota</h3>
    </div>
}
else if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2">Cargando información de la mascota...</p>
    </div>
}
else if (errorMessage != null)
{
    <div class="container">
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
        <button class="btn btn-secondary" @onclick="GoBack">← Volver</button>
    </div>
}
else if (mascota == null)
{
    <div class="text-center py-5">
        <h3>Mascota no encontrada</h3>
        <button class="btn btn-primary mt-3" @onclick="GoBack">← Volver a Mascotas</button>
    </div>
}
else
{
    <div class="container-fluid">
        @if (mascota.IsDeleted)
        {
            <div class="alert alert-danger" role="alert">
                <strong>Esta mascota ha sido eliminada</strong>
                <p class="mb-0">La mascota está marcada como eliminada. Usa el botón "Restaurar" para reactivarla.</p>
            </div>
        }
        
        @if (IsViewingOthersMascota())
        {
            <div class="alert alert-info" role="alert">
                <strong>Vista de consulta</strong>
                <p class="mb-0">Estás viendo la mascota de otro propietario. Solo puedes consultar la información, no editar ni eliminar.</p>
            </div>
        }
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <button class="btn btn-outline-secondary mb-2" @onclick="GoBack">
                    ← Volver
                </button>
                <h2 class="@(mascota.IsDeleted ? "text-muted text-decoration-line-through" : "")">Nombre de la mascota: @mascota.Nombre</h2>
                <p class="text-muted">Información completa de la mascota</p>
            </div>
            <div>
                @if (mascota.IsDeleted)
                {
                    @if (CanRestoreMascota())
                    {
                        <button class="btn btn-success btn-lg" @onclick="RestoreMascota">
                            Restaurar Mascota
                        </button>
                    }
                }
                else
                {
                    @if (CanEditMascota())
                    {
                        <button class="btn btn-warning me-2" @onclick="EditMascota">
                            Editar
                        </button>
                    }
                    @if (CanDeleteMascota())
                    {
                        <button class="btn btn-danger" @onclick="DeleteMascota">
                            Eliminar
                        </button>
                    }
                }
            </div>
        </div>

        <div class="row">
            <!-- Información Principal -->
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Información General</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th width="40%">Nombre:</th>
                                    <td><strong>@mascota.Nombre</strong></td>
                                </tr>
                                <tr>
                                    <th>Tipo:</th>
                                    <td>
                                        <span class="badge bg-info">@mascota.Tipo.ToUpper()</span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Raza:</th>
                                    <td>@mascota.Raza</td>
                                </tr>
                                <tr>
                                    <th>Edad:</th>
                                    <td>@mascota.Edad años</td>
                                </tr>
                                <tr>
                                    <th>Peso:</th>
                                    <td>@mascota.Peso kg</td>
                                </tr>
                                <tr>
                                    <th>Propietario Username:</th>
                                    <td>
                                        <strong>@mascota.Propietario</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Propietario Nombre:</th>
                                    <td>
                                        <strong>@mascota.PropietarioNombre</strong>
                                    </td>
                                </tr>
                                <tr>
                                        <th>Teléfono propietario:</th>
                                        <td>@mascota.PropietarioTelefono</td>
                                    </tr>
                                <tr>
                                    <th>Estado:</th>
                                    <td>
                                        @if (mascota.IsDeleted)
                                        {
                                            <span class="badge bg-danger">Eliminada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Activa</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Información Adicional -->
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Estado de Salud</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info mb-3">
                            <strong>Información:</strong>
                            <ul class="mb-0 mt-2">
                                <li>Esta mascota está registrada en el sistema</li>
                                <li>Puede tener historial de citas y vacunas</li>
                                <li>Consulta las secciones inferiores para más detalles</li>
                            </ul>
                        </div>

                        <div class="d-grid gap-2">
                            @if (!mascota.IsDeleted && !IsViewingOthersMascota())
                            {
                                <a href="/citas/crear?mascota=@mascota.IdMascota" class="btn btn-outline-primary">
                                    Agendar Cita
                                </a>
                                @if (CanRegisterVacuna())
                                {
                                    <a href="/vacunas/crear?mascota=@mascota.IdMascota" class="btn btn-outline-success">
                                        Registrar Vacuna
                                    </a>
                                }
                            }
                            else if (mascota.IsDeleted)
                            {
                                <div class="alert alert-warning mb-0">
                                    <small>Restaura la mascota para agendar citas o registrar vacunas</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sección de Historial Médico -->
        <div class="row">
            <div class="col-12 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <h5 class="mb-0 text-black">
                            <i class="bi bi-heart-pulse"></i> Historial Médico de @mascota.Nombre
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (isLoadingHistory)
                        {
                            <div class="text-center p-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando historial...</span>
                                </div>
                                <p class="mt-3 text-muted">Cargando historial médico...</p>
                            </div>
                        }
                        else
                        {
                            <!-- Nav tabs -->
                            <ul class="nav nav-tabs px-3 pt-3" id="historialTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(activeTab == "citas" ? "active" : "")" type="button" @onclick="@(() => activeTab = "citas")">
                                        Citas <span class="badge bg-primary rounded-pill ms-1">@citas.Count</span>
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(activeTab == "vacunas" ? "active" : "")" type="button" @onclick="@(() => activeTab = "vacunas")">
                                        Vacunas <span class="badge bg-success rounded-pill ms-1">@vacunas.Count</span>
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(activeTab == "facturas" ? "active" : "")" type="button" @onclick="@(() => activeTab = "facturas")">
                                        Facturas <span class="badge bg-warning rounded-pill ms-1">@facturas.Count</span>
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link @(activeTab == "recetas" ? "active" : "")" type="button" @onclick="@(() => activeTab = "recetas")">
                                        Recetas <span class="badge bg-info rounded-pill ms-1">@recetas.Count</span>
                                    </button>
                                </li>
                            </ul>

                            <!-- Tab content -->
                            <div class="tab-content p-3" id="historialTabContent">
                                <!-- Citas Tab -->
                                @if (activeTab == "citas")
                                {
                                    <div class="tab-pane-content">
                                    @if (citas.Count == 0)
                                    {
                                        <div class="alert alert-light text-center">
                                            <p class="mb-0">No hay citas registradas para esta mascota</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            @foreach (var cita in citas.OrderByDescending(c => c.Fecha))
                                            {
                                                <div class="col-md-6">
                                                    <div class="card h-100 border-start border-primary border-4 shadow-sm hover-card">
                                                        <div class="card-body">
                                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                                <h6 class="card-title mb-0">
                                                                    @cita.Fecha.ToString("dd/MM/yyyy HH:mm")
                                                                </h6>
                                                                <span class="badge @GetEstadoCitaBadge(cita.Estado)">
                                                                    @cita.Estado.ToUpper()
                                                                </span>
                                                            </div>
                                                            <p class="card-text text-muted small mb-2">
                                                                <strong>Motivo:</strong> @cita.Motivo
                                                            </p>
                                                            @if (!string.IsNullOrEmpty(cita.VeterinarioNombre))
                                                            {
                                                                <p class="card-text text-muted small mb-2">
                                                                    <strong>Veterinario:</strong> @cita.VeterinarioNombre
                                                                </p>
                                                            }
                                                            <div class="d-flex justify-content-end mt-3">
                                                                <a href="/citas/@cita.IdCita" class="btn btn-sm btn-outline-primary">
                                                                    Ver detalles →
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    </div>
                                }

                                <!-- Vacunas Tab -->
                                @if (activeTab == "vacunas")
                                {
                                    <div class="tab-pane-content">
                                    @if (vacunas.Count == 0)
                                    {
                                        <div class="alert alert-light text-center">
                                            <p class="mb-0">No hay vacunas registradas para esta mascota</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            @foreach (var vacuna in vacunas.OrderByDescending(v => v.FechaAplicacion))
                                            {
                                                <div class="col-md-6">
                                                    <div class="card h-100 border-start border-success border-4 shadow-sm hover-card">
                                                        <div class="card-body">
                                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                                <h6 class="card-title mb-0">
                                                                    <strong>Tipo vacuna: </strong>
                                                                    @{
                                                                        string tipo = vacuna.TipoVacuna switch
                                                                        {
                                                                            "rabia" => "Rabia",
                                                                            "parvovirus" => "Parvovirus",
                                                                            "moquillo" => "Moquillo",
                                                                            "leucemia_felina" => "Leucemia Felina",
                                                                            "triple_felina" => "Triple Felina",
                                                                            "newcastle" => "Newcastle",
                                                                            _ => vacuna.TipoVacuna // por si aparece otro valor
                                                                        };
                                                                    }
                                                                    @tipo
                                                                </h6>
                                                            </div>
                                                            <p class="card-text text-muted small mb-2">
                                                                <strong>Fecha aplicación:</strong> @vacuna.FechaAplicacion.ToString("dd/MM/yyyy")
                                                            </p>
                                                            @if (vacuna.ProximaDosis.HasValue)
                                                            {
                                                                <p class="card-text text-muted small mb-2">
                                                                    <strong>Próxima dosis:</strong> @vacuna.ProximaDosis.Value.ToString("dd/MM/yyyy")
                                                                </p>
                                                            }
                                                            @if (!string.IsNullOrEmpty(vacuna.VeterinarioNombre))
                                                            {
                                                                <p class="card-text text-muted small mb-2">
                                                                    <strong>Veterinario:</strong> @vacuna.VeterinarioNombre
                                                                </p>
                                                            }
                                                            <div class="d-flex justify-content-end mt-3">
                                                                <a href="/vacunas/@vacuna.IdVacuna" class="btn btn-sm btn-outline-success">
                                                                    Ver detalles →
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    </div>
                                }

                                <!-- Facturas Tab -->
                                @if (activeTab == "facturas")
                                {
                                    <div class="tab-pane-content">
                                    @if (facturas.Count == 0)
                                    {
                                        <div class="alert alert-light text-center">
                                            <p class="mb-0">No hay facturas registradas para esta mascota</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            @foreach (var factura in facturas.OrderByDescending(f => f.FechaFactura))
                                            {
                                                <div class="col-md-6">
                                                    <div class="card h-100 border-start border-warning border-4 shadow-sm hover-card">
                                                        <div class="card-body">
                                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                                <h6 class="card-title mb-0">
                                                                    @factura.NumeroFactura
                                                                </h6>
                                                                <span class="badge @GetEstadoFacturaBadge(factura.Estado)">
                                                                    @factura.Estado.ToUpper()
                                                                </span>
                                                            </div>
                                                            <p class="card-text text-muted small mb-2">
                                                                <strong>Fecha:</strong> @factura.FechaFactura.ToString("dd/MM/yyyy")
                                                            </p>
                                                            <p class="card-text text-muted small mb-2">
                                                                <strong>Servicio: </strong>
                                                                @if (factura.TipoServicio == "consulta_general")
                                                                {
                                                                    <strong>Consulta General</strong>
                                                                }
                                                                else if (factura.TipoServicio == "vacunacion")
                                                                {
                                                                    <strong>Vacunacion</strong>
                                                                }
                                                                else if (factura.TipoServicio == "cirugia")
                                                                {
                                                                    <strong>Cirugia</strong>
                                                                }
                                                                else if (factura.TipoServicio == "emergencia")
                                                                {
                                                                    <strong>Emergencia</strong>
                                                                }
                                                                else if (factura.TipoServicio == "control")
                                                                {
                                                                    <strong>Control</strong>
                                                                }
                                                                else if (factura.TipoServicio == "desparasitacion")
                                                                {
                                                                    <strong>Desparasitacion</strong>
                                                                }
                                                                else
                                                                {
                                                                    <strong>@factura.TipoServicio</strong>
                                                                }
                                                            </p>
                                                            <p class="card-text mb-2">
                                                                <strong class="text-success">Total: $@factura.Total.ToString("N0")</strong>
                                                            </p>
                                                            <div class="d-flex justify-content-end mt-3">
                                                                <a href="/facturas/@factura.IdFactura" class="btn btn-sm btn-outline-warning">
                                                                    Ver detalles →
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    </div>
                                }

                                <!-- Recetas Tab -->
                                @if (activeTab == "recetas")
                                {
                                    <div class="tab-pane-content">
                                    @if (recetas.Count == 0)
                                    {
                                        <div class="alert alert-light text-center">
                                            <p class="mb-0">No hay recetas registradas para esta mascota</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            @foreach (var receta in recetas.OrderByDescending(r => r.FechaEmision))
                                            {
                                                <div class="col-md-6">
                                                    <div class="card h-100 border-start border-info border-4 shadow-sm hover-card">
                                                        <div class="card-body">
                                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                                <h6 class="card-title mb-0">
                                                                    Receta
                                                                </h6>
                                                            </div>
                                                            <p class="card-text text-muted small mb-2">
                                                                <strong>Fecha emisión:</strong> @receta.FechaEmision.ToString("dd/MM/yyyy")
                                                            </p>
                                                            @if (!string.IsNullOrEmpty(receta.VeterinarioNombre))
                                                            {
                                                                <p class="card-text text-muted small mb-2">
                                                                    <strong>Veterinario:</strong> @receta.VeterinarioNombre
                                                                </p>
                                                            }
                                                            <div class="d-flex justify-content-end mt-3">
                                                                <a href="/recetas/@receta.IdReceta" class="btn btn-sm btn-outline-info">
                                                                    Ver detalles →
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Mascota? mascota;
    private bool isLoading = true;
    private bool isLoadingHistory = true;
    private string? errorMessage;

    // Historial médico
    private List<Cita> citas = new();
    private List<Vacuna> vacunas = new();
    private List<Factura> facturas = new();
    private List<Receta> recetas = new();
    private string activeTab = "citas"; // Tab activo por defecto

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadMascota();
        await LoadHistorialMedico();
    }

    private async Task LoadMascota()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            mascota = await MascotaService.GetMascotaAsync(Id);
            
            if (mascota == null)
            {
                errorMessage = "Mascota no encontrada";
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            if (ex.Message.Contains("expirado"))
            {
                await AuthService.LogoutAsync();
                Navigation.NavigateTo("/login", true);
            }
            else
            {
                errorMessage = ex.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar la mascota: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditMascota()
    {
        Navigation.NavigateTo($"/mascotas/{Id}/editar");
    }

    private async Task DeleteMascota()
    {
        if (!CanDeleteMascota())
        {
            errorMessage = "No tienes permisos para eliminar esta mascota.";
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"¿Estás seguro de que deseas eliminar a {mascota?.Nombre}?"))
        {
            return;
        }

        try
        {
            var success = await MascotaService.DeleteMascotaAsync(Id);
            if (success)
            {
                Navigation.NavigateTo("/mascotas");
            }
            else
            {
                errorMessage = "Error al eliminar la mascota.";
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            if (ex.Message.Contains("expirado"))
            {
                await AuthService.LogoutAsync();
                Navigation.NavigateTo("/login", true);
            }
            else
            {
                errorMessage = ex.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al eliminar: " + ex.Message;
        }
    }

    private bool CanEditMascota()
    {
        if (mascota == null) return false;
        
        var role = AuthService.CurrentUser?.Role;
        var username = AuthService.CurrentUser?.Username;
        
        // Admin puede editar cualquier mascota
        if (role == "admin")
            return true;
        
        // Veterinarios y clientes solo pueden editar sus propias mascotas
        if ((role == "veterinario" || role == "cliente") && mascota.Propietario == username)
            return true;
        
        return false;
    }

    private bool CanDeleteMascota()
    {
        if (mascota == null) return false;
        
        var role = AuthService.CurrentUser?.Role;
        var username = AuthService.CurrentUser?.Username;
        
        // Admin puede eliminar cualquier mascota
        if (role == "admin")
            return true;
        
        // Veterinarios y clientes solo pueden eliminar sus propias mascotas
        if ((role == "veterinario" || role == "cliente") && mascota.Propietario == username)
            return true;
        
        return false;
    }

    private bool CanRestoreMascota()
    {
        if (mascota == null) return false;
        
        var role = AuthService.CurrentUser?.Role;
        var username = AuthService.CurrentUser?.Username;
        
        // Admin puede restaurar cualquier mascota
        if (role == "admin")
            return true;
        
        // Veterinarios y clientes solo pueden restaurar sus propias mascotas
        if ((role == "veterinario" || role == "cliente") && mascota.Propietario == username)
            return true;
        
        return false;
    }

    private bool IsViewingOthersMascota()
    {
        if (mascota == null) return false;
        
        var role = AuthService.CurrentUser?.Role;
        var username = AuthService.CurrentUser?.Username;
        
        // Solo relevante para veterinarios
        // Si es veterinario y NO es el propietario, entonces está viendo la mascota de otro
        return role == "veterinario" && mascota.Propietario != username;
    }

    private async Task RestoreMascota()
    {
        if (!CanRestoreMascota())
        {
            errorMessage = "No tienes permisos para restaurar esta mascota.";
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"¿Estás seguro de que deseas restaurar a {mascota?.Nombre}?"))
        {
            return;
        }

        try
        {
            var success = await MascotaService.RestoreMascotaAsync(Id);
            if (success)
            {
                // Recargar la mascota para actualizar el estado
                await LoadMascota();
            }
            else
            {
                errorMessage = "Error al restaurar la mascota.";
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            if (ex.Message.Contains("expirado"))
            {
            await AuthService.LogoutAsync();
                Navigation.NavigateTo("/login", true);
            }
            else
            {
                errorMessage = ex.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al restaurar: " + ex.Message;
        }
    }

    private bool CanRegisterVacuna()
    {
        var role = AuthService.CurrentUser?.Role;
        return role == "admin" || role == "veterinario";
    }

    private async Task LoadHistorialMedico()
    {
        // Validar que tengamos un ID válido
        if (string.IsNullOrEmpty(Id))
        {
            Console.WriteLine("Error: ID de mascota vacío en LoadHistorialMedico");
            return;
        }

        isLoadingHistory = true;
        
        try
        {
            Console.WriteLine($"Cargando historial clínico para mascota: {Id}");
            
            // Usar endpoints específicos de mascota para historial clínico completo
            // Estos endpoints devuelven TODAS las vacunas/citas/recetas de esta mascota
            // (no solo las del veterinario actual - necesario para historial clínico completo)
            
            var citasTask = CitaService.GetCitasByMascotaAsync(Id, page: 1, pageSize: 100, includeDeleted: true);
            var vacunasTask = VacunaService.GetVacunasByMascotaAsync(Id, page: 1, pageSize: 100, includeDeleted: false);
            var facturasTask = FacturaService.GetFacturasByMascotaAsync(Id, page: 1, pageSize: 100, includeDeleted: false);
            var recetasTask = RecetaService.GetRecetasByMascotaAsync(Id, page: 1, pageSize: 100, includeDeleted: false);

            await Task.WhenAll(citasTask, vacunasTask, facturasTask, recetasTask);

            var citasResponse = await citasTask;
            var vacunasResponse = await vacunasTask;
            var facturasResponse = await facturasTask;
            var recetasResponse = await recetasTask;

            // Ya NO necesitamos filtrar porque el backend devuelve solo las de esta mascota
            citas = citasResponse?.Items ?? new List<Cita>();
            vacunas = vacunasResponse?.Items ?? new List<Vacuna>();
            facturas = facturasResponse?.Items ?? new List<Factura>();
            recetas = recetasResponse?.Items ?? new List<Receta>();

            Console.WriteLine($"Historial cargado - Citas: {citas.Count}, Vacunas: {vacunas.Count}, Facturas: {facturas.Count}, Recetas: {recetas.Count}");
        }
        catch (UnauthorizedAccessException ex)
        {
            Console.WriteLine($"No autorizado al cargar historial: {ex.Message}");
            // No mostramos error al usuario, simplemente dejamos las listas vacías
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar historial: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            // No mostramos error al usuario, simplemente dejamos las listas vacías
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private string GetEstadoCitaBadge(string estado)
    {
        return estado?.ToLower() switch
        {
            "completada" => "bg-success",
            "pendiente" => "bg-warning text-dark",
            "cancelada" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetEstadoFacturaBadge(string estado)
    {
        return estado?.ToLower() switch
        {
            "pagada" => "bg-success",
            "pendiente" => "bg-warning text-dark",
            "cancelada" => "bg-danger",
            _ => "bg-secondary"
        };
    }

